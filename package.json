{
  "type": "module",
  "scripts": {
    "lint": "eslint www/",
    "format:check": "prettier --check www/",
    "check": "npm run lint && npm run format:check && npm run test:unit",
    "test:unit": "node --test tests/js/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/js/*.test.js"
  },
  "devDependencies": {
    "eslint": "^7.6.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-prettier": "^3.1.4",
    "prettier": "^2.0.5"
  }
}
